# Environment configuration for AI Platform Dashboard backend
# Copy this file to .env and fill in values

APP_NAME="AI Platform Dashboard"
ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenTelemetry (set OTEL_ENABLED=true to activate)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-platform-dashboard
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Azure Monitor (optional — leave blank for local dev)
AZURE_MONITOR_CONNECTION_STRING=

# Ollama / local LLM runtime (optional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# CORS — JSON array
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
