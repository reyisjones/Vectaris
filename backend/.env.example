# Environment configuration for AI Platform Dashboard backend
# Copy this file to .env and fill in values

APP_NAME="AI Platform Dashboard"
ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenTelemetry (set OTEL_ENABLED=true to activate)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-platform-dashboard
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Azure Monitor (optional — leave blank for local dev)
AZURE_MONITOR_CONNECTION_STRING=

# Ollama / local LLM runtime (optional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# CORS — JSON array
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# API key auth — leave blank to disable. When set, /api/v1/** requires the
# header configured below.
API_KEY=
API_KEY_HEADER=X-API-Key

# OIDC / Azure Entra ID auth (takes priority over API_KEY when set).
# Azure example:
#   OIDC_ISSUER=https://login.microsoftonline.com/{tenant_id}/v2.0
#   OIDC_AUDIENCE=api://{app_id}
# Leave OIDC_JWKS_URI empty to auto-discover from {OIDC_ISSUER}/.well-known/openid-configuration
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# Prometheus (metrics adapter) — leave empty to use stub data
PROMETHEUS_URL=

# OpenAI (cost adapter) — when set, costs are sourced from /v1/usage
OPENAI_API_KEY=
OPENAI_ORG_ID=
